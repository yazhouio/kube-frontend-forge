{
  "id": "Text",
  "schema": {
    "templateInputs": {
      "TEXT": {
        "type": "string",
        "description": "Text content"
      },
      "DEFAULT_VALUE": {
        "type": "number",
        "description": "Default value"
      }
    }
  },
  "generateCode": {
    "imports": [
      "import * as React from \"react\"",
      "import { useState } from \"react\""
    ],
    "jsx": "<div>{%%TEXT%%}</div>",
    "stats": [
      {
        "id": "textState",
        "scope": "functionBody",
        "code": "const [text, setText] = useState(%%DEFAULT_VALUE%%);",
        "output": ["text", "setText"],
        "depends": []
      }
    ],
    "meta": {
      "inputPaths": {
        "$jsx": ["TEXT"],
        "textState": ["DEFAULT_VALUE"]
      }
    }
  }
}
