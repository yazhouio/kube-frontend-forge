{
  "name": "@frontend-forge/project-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scaffold"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "packageManager": "pnpm@11.1.0",
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  }
}
