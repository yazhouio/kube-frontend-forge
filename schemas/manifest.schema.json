            "args": {
              "type": "array",
              "items": true,
              "default": []
            },
            "autoLoad": {
              "type": "boolean"
            },
            "polling": true
          },
          "x-outputs": [
            "create",
            "data",
            "del",
            "loading",
            "pageContext",
            "params",
            "refetch",
            "toolbarLeft",
            "update"
          ]
        }
      ]
    },
    "actionGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "default": {}
        },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/actionNode"
          },
          "default": {}
        }
      }
